# Copia in `.env` e riempi con i valori del tuo progetto Supabase.
# La publishable key è pensata per stare nel browser: le protezioni vere sono
# le policy RLS sulle tabelle, non la segretezza di questa chiave.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Lo schema Postgres in cui vive Ciclo. Va anche aggiunto agli "Exposed
# schemas" in Project Settings → API, altrimenti PostgREST non lo serve.
VITE_SUPABASE_SCHEMA=samar
