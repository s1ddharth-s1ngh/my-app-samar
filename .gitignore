# Agent skills: the real files live in .agents/skills and are committed.
# `.claude/skills` holds absolute symlinks into them, regenerated per machine
# by `npx skills add supabase/agent-skills` — they would not survive a clone.
.claude/skills/

# Local environment. `.env.example` documents the keys; the real values stay here.
.env
.env.local

# Capacitor: the native shell is committed, its build output is not.
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/
android.sync-backup/
